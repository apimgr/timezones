# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf

# Scripts
*.sh text eol=lf
*.bash text eol=lf
Makefile text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Config
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf

# Docker
Dockerfile text eol=lf
.dockerignore text eol=lf

# CI/CD
Jenkinsfile text eol=lf
